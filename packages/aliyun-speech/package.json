{
  "name": "@gaozh1024/aliyun-speech",
  "version": "0.2.0",
  "description": "Aliyun real-time speech-to-text package for Expo / React Native with headless hooks and optional UI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "ai-manifest.json",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@siteed/audio-studio": ">=3 <4",
    "expo": ">=54 <56",
    "expo-audio": ">=1 <56",
    "react": ">=19.1.0 <20",
    "react-native": ">=0.81 <0.84"
  },
  "devDependencies": {
    "@siteed/audio-studio": "3.0.2",
    "@types/react": "~19.2.10",
    "expo": "~55.0.26",
    "expo-audio": "~55.0.14",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "keywords": [
    "@gaozh1024",
    "@gaozh1024/aliyun-speech",
    "aliyun-speech",
    "aliyun",
    "speech",
    "asr",
    "react-native",
    "expo",
    "voice-to-text"
  ],
  "license": "MIT"
}
