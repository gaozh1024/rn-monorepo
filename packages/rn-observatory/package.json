{
  "name": "@gaozh1024/rn-observatory",
  "version": "0.4.0",
  "description": "Observability and product analytics SDK for Expo / React Native.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "ai-manifest.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.79 <0.82"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "keywords": [
    "@gaozh1024",
    "@gaozh1024/rn-observatory",
    "rn-observatory",
    "react-native",
    "expo",
    "monitoring",
    "observability",
    "analytics",
    "crash"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
