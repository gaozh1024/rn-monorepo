    "expo-image": ">=3 <56",
    "expo-image-manipulator": ">=14 <56",
    "expo-media-library": ">=18 <56",
    "expo-video": ">=55 <56",
    "react": ">=19.1.0 <20",
    "react-native": ">=0.81 <0.84",
    "react-native-gesture-handler": ">=2.19.0 <3",
    "react-native-reanimated": ">=4.1 <5",
    "react-native-safe-area-context": ">=4 <6",
    "react-native-zoom-toolkit": ">=5 <6"
  },
  "devDependencies": {
    "@gaozh1024/rn-kit": "workspace:*",
    "@react-navigation/native": "^7.2.1",
    "@shopify/flash-list": "2.0.2",
    "@types/react": "~19.2.10",
    "expo": "~55.0.26",
    "expo-image": "~55.0.11",
