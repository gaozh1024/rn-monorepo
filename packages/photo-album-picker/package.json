{
  "name": "@gaozh1024/photo-album-picker",
  "version": "0.4.2",
  "description": "Photo album picker for Expo / React Native with grid picker, preview and crop flow.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AI_USAGE.md",
    "ai-manifest.json",
    "LICENSE"
