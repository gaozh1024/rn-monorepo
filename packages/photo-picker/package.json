{
  "name": "@gaozh1024/photo-picker",
  "version": "0.1.0",
  "description": "Permissionless Android system photo picker for Expo / React Native with review and crop flow.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "android",
    "expo-module.config.json",
    "react-native.config.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7.0.0",
    "expo-modules-core": ">=55 <56",
    "expo-image": ">=3 <56",
    "expo-image-manipulator": ">=14 <56",
    "react": ">=19.1.0 <20",
    "react-native": ">=0.81 <0.84",
    "react-native-safe-area-context": ">=4 <6",
    "react-native-zoom-toolkit": ">=5 <6"
  },
  "devDependencies": {
    "@react-navigation/native": "^7.2.1",
    "@types/react": "~19.2.10",
    "expo-modules-core": "~55.0.25",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-zoom-toolkit": "^5.0.1"
  },
  "keywords": [
    "@gaozh1024",
    "photo-picker",
    "react-native",
    "expo",
    "android-photo-picker"
  ],
  "license": "MIT"
}
