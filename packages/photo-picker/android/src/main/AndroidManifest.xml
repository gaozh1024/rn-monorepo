<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent>
      <action android:name="android.provider.action.PICK_IMAGES" />
    </intent>
    <!-- Minimal package visibility for the verified vendor gallery adapter
         (huawei-gallery). Never request QUERY_ALL_PACKAGES here. -->
    <package android:name="com.huawei.photos" />
  </queries>
</manifest>
