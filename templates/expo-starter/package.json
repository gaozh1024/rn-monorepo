{
  "name": "@gaozh1024/expo-starter",
  "version": "0.3.0",
  "description": "Expo starter template based on @gaozh1024/rn-kit",
  "main": "index.js",
  "files": [
    ".gitignore",
    "App.tsx",
    "index.js",
    "README.md",
    "AI_USAGE.md",
    ".env.local.dev",
    ".env.local.server",
    ".env.production",
    "app.json",
    "ai-manifest.json",
    "assets",
    "babel.config.js",
    "global.css",
    "metro.config.js",
    "nativewind-env.d.ts",
    "scripts",
    "src",
    "tailwind.config.js",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "expo start",
    "env:dev": "cp .env.local.dev .env.local",
    "env:server": "cp .env.local.server .env.local",
    "android": "expo run:android",
    "android:release": "node scripts/build-android-release.mjs --env-file .env.production",
    "android:release:prod": "node scripts/build-android-release.mjs --env-file .env.production",
    "android:release:staging": "node scripts/build-android-release.mjs --env-file .env.local.server",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web --output-dir dist",
    "web:build:clear": "expo export --platform web --output-dir dist --clear",
    "web:build:staging": "node scripts/build-web-export.mjs --env-file .env.local.server",
    "web:build:prod": "node scripts/build-web-export.mjs --env-file .env.production",
    "web:build:staging:clear": "node scripts/build-web-export.mjs --env-file .env.local.server --clear",
    "web:build:prod:clear": "node scripts/build-web-export.mjs --env-file .env.production --clear",
    "lint": "tsc --noEmit",
    "test": "node --test",
    "ota:prepare": "node node_modules/@gaozh1024/hot-updater/scripts/prepare-release.mjs",
    "ota:filemeta": "node node_modules/@gaozh1024/hot-updater/scripts/print-file-meta.mjs",
    "ota:manifest": "node node_modules/@gaozh1024/hot-updater/scripts/build-manifest.mjs",
    "observatory:publish:android": "node scripts/publish-observatory-release.mjs --platform android"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "@gaozh1024",
    "@gaozh1024/expo-starter",
    "expo-starter",
    "expo",
    "expo-template",
    "react-native",
    "starter",
    "template"
  ],
  "license": "MIT",
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@gaozh1024/rn-kit": "^0.6.0",
    "@gaozh1024/rn-observatory": "^0.6.1",
    "@react-native-masked-view/masked-view": "~0.3.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^7.8.5",
    "expo": "~55.0.26",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "@gaozh1024/hot-updater": "^0.2.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.3"
  }
}
